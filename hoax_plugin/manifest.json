{
  "manifest_version": 3,
  "name": "IndoBERT Hoax Detector",
  "version": "1.0",
  "description": "Otomatis mendeteksi hoaks pada judul berita secara real-time menggunakan IndoBERT.",
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}